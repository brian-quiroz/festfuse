# Backend database connection.
#
# Copy this file to backend/.env and set the values for your local PostgreSQL
# database. All five variables are required (see backend/app/config.py); the backend
# refuses to start if any is missing.
#
# The hosted Railway deployment sets these from its private Postgres service. Those
# resolved values are never committed.
#
# See docs/operations/local-development.md for local setup and
# docs/operations/backup-restore.md for rebuilding a database from a dump.

POSTGRES_USER=festfuse
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=festfuse
